
@model Monografia.Models.Modelo_contenedor
@{
    Layout = "~/Views/Menu/Menu_tienda.cshtml";
}
@Styles.Render("~/Scripts/Datatable")
@using (Html.BeginForm("Corte", "Facturacion", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="card border-top border-0 border-3 border-info">
        <div class="card-header"><h4 class="text-center">Corte de caja</h4>   </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="alert alert-primary alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-1"></i>
                <strong>Antes de efectuar el cierre, asegúrese de que su caja esté correctamente cuadrada.</strong>
            </div>
        </div>

    </div>

    @*<div class="card">
        <div class="card-header text-center">
            <h4>Corte de caja</h4>
        </div>
        <div class="card-body" id="frmdatosclientes">
            <br>*@
    <div class="row">
        <div class="col-lg-12">
            <div class="row">
                <div class="col-xxl-6 col-md-6">
                    <div class="card border-start border-0 border-3 border-success">
                        <h5 class="card-title text-center">Resumen Corte</h5>
                        <div class="card-body">
                            @if (Model.corteResumen != null)
                            {
                                <div class="row">
                                    <div class="col-md-6">
                                        <i>CANTIDAD TOTAL DE FACTURAS</i>
                                        @Html.TextBox("txtcantidadFacturas", Model.corteResumen["CANTIDAD_FACTURAS"], new { @class = "form-control", @readonly = "readonly" })
                                    </div>
                                    <div class="col-md-6">
                                        <i>MONTO TOTAL DE FACTURAS C$</i>
                                        @Html.TextBox("txtmontoFacturas", Model.corteResumen["MONTO_FACTURAS"], new { @class = "form-control", @readonly = "readonly" })
                                    </div>
                                    @*<div class="col-md-6">
                                            <i>FACTURAS</i>
                                            @Html.TextBox("txtidsFacturas", Model.corteResumen["ID_FACTURAS"], new { @class = "form-control", @readonly = "readonly" })
                                        </div>*@
                                </div>
                                <br />
                                <div class="row">
                                    <div class="col-md-6">
                                        <i>PRODUCTOS TOTAL FACTURADOS</i>
                                        @Html.TextBox("txtcantidadProductos", Model.corteResumen["CANTIDAD_DE_PRODUCTOS_FACTURADOS"], new { @class = "form-control", @readonly = "readonly" })
                                    </div>
                                    <div class="col-md-6">
                                        <i>TOTAL DE PAGOS REALIZADOS C$</i>
                                        @Html.TextBox("txttotalPagos", Model.corteResumen["TOTAL_PAGOS"], new { @class = "form-control", @readonly = "readonly" })
                                    </div>

                                </div>
                                @*<br />
                                    <div class="row">

                                        <div class="col-md-6">
                                            <i>PRODUCTOS FACTURADOS</i>
                                            @Html.TextBox("txtproductosFacturados", Model.corteResumen["ID_PRODUCTOS_FACTURADOS"], new { @class = "form-control", @readonly = "readonly" })
                                        </div>
                                    </div>*@
                                @*<br />
                                    <div class="row">
                                        <div class="col-md-6">

                                            <i>CAJEROS DEL DIA</i>
                                            @Html.TextBox("txtcajerosDelDia", Model.corteResumen["CAJEROS_DEL_DIA"], new { @class = "form-control", @readonly = "readonly" })
                                        </div>
                                    </div>*@
                            }
                        </div>
                    </div>

                </div>
                <div class="col-xxl-6 col-md-6">
                    <div class="card border-start border-0 border-3 border-warning">
                        <h5 class="card-title text-center">Resumen de Ventas</h5>
                        <div class="card-body">
                            @if (Model.cortePagoCreditos != null)
                            {
                                <div class="row">
                                    <div class="col-md-6">
                                        <i>TOTAL PAGOS EN EFECTIVO C$</i>
                                        @Html.TextBox("txtefectivo", Model.cortePagoCreditos["EFECTIVO"], new { @class = "form-control", @readonly = "readonly" })
                                    </div>
                                    <div class="col-md-6">
                                        <i>PAGOS EN EFECTIVO</i>
                                        @Html.TextBox("txtefectivocant", Model.cortePagoCreditos["CANTIDAD_EFECTIVO"], new { @class = "form-control", @readonly = "readonly" })
                                    </div>

                                </div>
                                <br />
                                <div class="row">
                                    <div class="col-md-6">
                                        <i>TOTAL PAGOS CRÉDITOS C$</i>
                                        @Html.TextBox("txtcredito", Model.cortePagoCreditos["CREDITO"], new { @class = "form-control", @readonly = "readonly" })
                                    </div>
                                    <div class="col-md-6">
                                        <i>PAGOS A CRÉDITOS</i>
                                        @Html.TextBox("txtcreditocant", Model.cortePagoCreditos["CANTIDAD_CREDITO"], new { @class = "form-control", @readonly = "readonly" })
                                    </div>
                                </div>


                            }
                        </div>

                    </div>
                </div>
                <div class="col-xxl-6 col-md-6">
                    <div class="card border-start border-0 border-3 border-danger">
                        <h5 class="card-title text-center">Productos vendidos por departamento</h5>
                        <div class="card-body">

                            <div class="row">
                                <table id="tbproductosdepartamentos" class="table table-striped table-bordered" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>
                                                @Html.DisplayName("Código de producto")
                                            </th>
                                            <th>
                                                @Html.DisplayName("Cantidad producto")
                                            </th>
                                            <th>
                                                @Html.DisplayName("Descripción de departamento")
                                            </th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var item in Model.corteProductos)
                                        {
                                            <tr>
                                                <td>
                                                    @item["CODIGO_PRODUCTO"]
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(Dictionary => item["CANTIDAD_PRODUCTO"])
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(Dictionary => item["DEPARTAMENTO"])
                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>
                            </div>
                        </div>

                    </div>
                </div>




            </div>
        </div>
    </div>

    <div class="card border-bottom border-0 border-3 border-info">
        <div class="card-footer text-center">
            <button type="submit" class="btn btn-primary" @*hidden="@Session["PerfilPermisos"].ToString().Contains("|V1|").Equals(false)"*@>
                <i class="fa fa-money">Realizar cierre de caja </i>
            </button>
        </div>
    </div>
    <input type="hidden" id="Mensaje" value="@ViewBag.mensajeexito" />
}
@section Scripts
{
    @Scripts.Render("~/bundles/datatables")
    <script type="text/javascript">
            $(function () {
                $('#tbproductosdepartamentos').DataTable({
                    "language": {
                        "url": "/Scripts/es_es.json"
                    },scrollX:true
                })
                var tableIds = ['tbproductosdepartamentos']; // Lista de IDs de las tablas
                redimensionatable(tableIds);
            });

    </script>
}







