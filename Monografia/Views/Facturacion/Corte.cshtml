
@model Monografia.Models.Modelo_contenedor
@{
    Layout = "~/Views/Menu/Menu_tienda.cshtml";
}
@using (Html.BeginForm("Corte", "Facturacion", FormMethod.Post))
{
    <div class="card">
        <div class="card-header text-center">
            <h4>Corte de caja</h4>
        </div>
        <div class="card-body" id="frmdatosclientes">
            <br>
            <div class="row">

                <!-- Left side columns -->
                <div class="col-lg-12">
                    <div class="row">

                        <!-- base de datos Card -->
                        <!--<div class="col-xxl-6 col-md-3">
                            <div class="card info-card sales-card cards align-items-center border-start border-0 border-3 border-info">
                                <h5 class="card-title text-center">Entradas de efectivo</h5>
                                <div class="card-body">


                                </div>

                            </div>-->

                        <!--</div>--><!-- End base de datos Card -->
                        <!-- Customers Card -->
                        <div class="col-xxl-6 col-md-3">
                            <div class="card info-card sales-card cards align-items-center border-start border-0 border-3 border-success">
                                <h5 class="card-title text-center">Resumen Corte</h5>
                                <div class="card-body">
                                    @if (Model.corteResumen != null)
                                    {
                                        <i>CANTIDAD FACTURAS</i>                                    
                                        @Html.TextBox("txtcantidadFacturas", Model.corteResumen["CANTIDAD_FACTURAS"], new { @class = "form-control" })
                                        <i>FACTURAS</i>                            
                                        @Html.TextBox("txtidsFacturas", Model.corteResumen["ID_FACTURAS"], new { @class = "form-control" })
                                        <i>TOTAL PAGOS</i>                                    
                                        @Html.TextBox("txttotalPagos", Model.corteResumen["TOTAL_PAGOS"], new { @class = "form-control" })
                                        <i>MONTO FACTURAS</i>                                  
                                        @Html.TextBox("txtmontoFacturas", Model.corteResumen["MONTO_FACTURAS"], new { @class = "form-control" })
                                        <i>CANTIDAD DE PRODUCTOS FACTURADOS</i>                                    
                                        @Html.TextBox("txtcantidadProductos", Model.corteResumen["CANTIDAD_DE_PRODUCTOS_FACTURADOS"], new { @class = "form-control" })
                                        <i>PRODUCTOS FACTURADOS</i>                            
                                        @Html.TextBox("txtproductosFacturados", Model.corteResumen["ID_PRODUCTOS_FACTURADOS"], new { @class = "form-control" })
                                        <i>CAJEROS DEL DIA</i>
                                        @Html.TextBox("txtcajerosDelDia", Model.corteResumen["CAJEROS_DEL_DIA"], new { @class = "form-control" })
                                    }
                                </div>
                            </div>

                        </div><!-- End Customers Card -->
                        <!-- folios Card -->
                        <div class="col-xxl-6 col-md-3">
                            <div class="card info-card sales-card cards align-items-center border-start border-0 border-3 border-warning">
                                <h5 class="card-title text-center">Pagos</h5>
                                <div class="card-body">
                                    @if (Model.cortePagoCreditos != null)
                                    {
                                        <i> EFECTIVO</i>
                                        @Html.TextBox("txtefectivo", Model.cortePagoCreditos["EFECTIVO"], new { @class = "form-control" })
                                        <i> CREDITO</i>
                                        @Html.TextBox("txtcredito", Model.cortePagoCreditos["CREDITO"], new { @class = "form-control" })
                                    }
                                </div>

                            </div>
                        </div><!-- End folios Card -->
                        <!-- Articulos precargados Card -->
                        <div class="col-xxl-6 col-md-3">
                            <div class="card info-card sales-card cards align-items-center border-start border-0 border-3 border-danger">
                                <h5 class="card-title text-center">Productos por departamento</h5>
                                <div class="card-body">
                           

                                    <table id="tbproductos" class="table table-bordered" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>
                                                    @Html.DisplayName("PRODUCTO")
                                                </th>
                                                <th>
                                                    @Html.DisplayName("CANTIDAD PRODUCTO")
                                                </th>
                                                <th>
                                                    @Html.DisplayName("DEPARTAMENTO")
                                                </th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            @foreach (var item in Model.corteProductos)
                                            {
                                                <tr>
                                                    <td>
                                                        @Html.DisplayFor(Dictionary => item["ID_PRODUCTO"])
                                                    </td>
                                                    <td>
                                                        @Html.DisplayFor(Dictionary => item["CANTIDAD_PRODUCTO"])
                                                    </td>
                                                    <td>
                                                        @Html.DisplayFor(Dictionary => item["DEPARTAMENTO"])
                                                    </td>

                                                </tr>
                                            }

                                        </tbody>

                                    </table>

                                </div>

                            </div>
                        </div><!-- End Articulos precargados Card -->




                    </div>
                </div>


            </div>
        </div>
        @*<div class="card-footer text-center">
            <a data-modal="" href=@Url.Action("Edit", "Admin_clientes") class="btn btn-outline-success"> <i class="fa fa-cash-register">Pago de clientes</i></a>

            <a data-modal="" href=@Url.Action("Edit", "Admin_clientes") class="btn btn-outline-success"> <i class="fa fa-industry">Pago a proveedores</i></a>
        </div>*@
    </div>


}








